  },
  "files": [
    "index.mjs",
    "producer.mjs",
    "hints.mjs",
    "cordis.patch.yml",
    "locale",
    "icon.svg"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1 || 4.0.5 || 4.0.6-alpha.1"
  },
  "dsh": {
