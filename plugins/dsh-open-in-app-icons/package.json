{
  "name": "@local/dsh-open-in-app-icons",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Provide cacheable generic icons for explicitly selected local applications without changing DSH Core.",
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/fallback.svg"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "assets",
    "locale",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
