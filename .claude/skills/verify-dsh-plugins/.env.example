# Copy to .env (git-ignored) and change what differs on this machine.
# Every line is optional; the value shown is the default.
# Variables set in the shell environment override this file.

# Built DSH checkout that provides the CLI, the mock LLM, and Playwright.
DSHV_DSH_ROOT=$REPO/../deepseek-harness

# Where disposable instances live. `dshv down` deletes each run directory.
DSHV_RUN_ROOT=${TMPDIR:-/tmp}/dshv

# Where evidence is kept. It survives `dshv down`.
DSHV_EVIDENCE_ROOT=$REPO/reports/verify-dsh-plugins

# Playwright's browser cache. The instance runs with its own HOME, so this must point at the real one.
PLAYWRIGHT_BROWSERS_PATH=$HOME/.cache/ms-playwright

# Port of the operator's live web host, which runs must never touch. Doctor fails if a run owns it.
DSHV_LIVE_PORT=3080

# Script for the mock LLM, read at `dshv up`. See llm-mock-server's README in the DSH checkout.
DSHV_MOCK_SEQUENCE=success
